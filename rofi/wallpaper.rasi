@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    spacing: 6px;
}

window {
    location: center;
    anchor: center;
    width: 86%;
    height: 86%;
    border: 2px;
    border-color: @border-color;
    border-radius: 18px;
    background-color: @background;
    padding: 16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    padding: 10px 12px;
    spacing: 8px;
    border-radius: 10px;
    background-color: @normal-background;
    border: 1px;
    border-color: @border-color;
}

prompt {
    text-color: @selected-normal-background;
    background-color: transparent;
}

entry {
    text-color: @normal-foreground;
    placeholder: "Search wallpapers...";
    placeholder-color: @border-color;
    background-color: transparent;
}

listview {
    columns: 4;
    lines: 2;
    fixed-columns: true;
    fixed-height: true;
    cycle: true;
    spacing: 12px;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: vertical;
    children: [ element-icon ];
    padding: 8px;
    border: 3px;
    border-radius: 14px;
}

/* Trạng thái các hình ảnh bình thường */
element normal.normal,
element alternate.normal {
    background-color: @normal-background;
    border-color: transparent;
}

/* Trạng thái hình ảnh ĐANG ĐƯỢC CHỌN (Nổi bật viền và nền) */
element selected.normal,
element selected.active {
    background-color: @selected-normal-background;
    border-color: @active-foreground;
}

element-icon {
    size: 14em;
    expand: true;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    enabled: false;
}
