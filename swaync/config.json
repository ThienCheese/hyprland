
{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "right",
  "positionY": "top",

  "control-center-positionX": "none",
  "control-center-positionY": "none",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,

  "control-center-width": 430,
  "control-center-height": -1,
  "fit-to-screen": true,

  "layer-shell": true,
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell-cover-screen": false,
  "cssPriority": "user",

  "notification-window-width": 430,
  "notification-body-image-height": 120,
  "notification-body-image-width": 220,
  "notification-inline-replies": true,

  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,

  "widgets": [
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],

  "widget-config": {
    
"buttons-grid": {
  "buttons-per-row": 5,
  "actions": [
    {
      "label": "󰍛",
      "type": "button",
      "command": "sh -lc '$HOME/.config/swaync/system-info.sh ram'",
      "tooltip": "Memory usage"
    },
    {
      "label": "󰋊",
      "type": "button",
      "command": "sh -lc '$HOME/.config/swaync/system-info.sh disk'",
      "tooltip": "Root disk usage"
    },
    {
      "label": "󰠖",
      "type": "button",
      "command": "sh -lc '$HOME/.config/swaync/system-info.sh cpu'",
      "tooltip": "CPU usage"
    },
    {
      "label": "󰉼",
      "type": "button",
      "command": "sh -lc '$HOME/.config/hypr/scripts/wallpaper_random.sh'",
      "tooltip": "Random wallpaper"
    },
    {
      "label": "󰂛",
      "type": "toggle",
      "command": "swaync-client -d",
      "update-command": "swaync-client --get-dnd",
      "tooltip": "Do Not Disturb"
    }
  ]
}
,

    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },

    "backlight": {
      "label": "󰃠",
      "min": 1
    },

    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": true
    },

    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },

    "notifications": {
      "vexpand": true
    }
  }
}
